# Copy to .env.local (never commit .env.local). Add the same values in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://your-project-ref.supabase.co
# The *secret* key (sb_secret_… or the legacy service_role key). Server-only — never expose it.
SUPABASE_SECRET_KEY=

# Admin login at /admin
ADMIN_PASSWORD=
# 32+ random characters. Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Order notifications (all optional). Each turns on when its values are set.
# Email via resend.com: with the free shared sender, NOTIFY_EMAIL_TO must be the address you signed up with.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
# NOTIFY_EMAIL_FROM="Layer Cake Orders <orders@yourdomain.com>"   # only once you've verified your own domain
# Phone push via pushover.net
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Link base for messages. Defaults to your Vercel production URL.
# SITE_URL=https://yourshop.com
